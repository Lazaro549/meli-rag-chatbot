# ================================
# meli-rag-chatbot configuration
# ================================

# Set to "true" to run completely offline with high-quality mock data
USE_MOCK=true

# ---- Amazon Bedrock (optional when USE_MOCK=true) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# ---- Mercado Libre (optional when USE_MOCK=true) ----
MELI_ACCESS_TOKEN=
MELI_SITE_ID=MLA
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# ---- RAG ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/faiss_index
